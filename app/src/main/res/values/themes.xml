<resources>
    <style name="Theme.Wolf" parent="Theme.MaterialComponents.NoActionBar">
        <!-- الألوان الأساسية -->
        <item name="colorPrimary">#0F2233</item>
        <item name="colorPrimaryDark">#0B1929</item>
        <item name="colorAccent">#4FC3F7</item>
        <item name="colorSecondary">#0F2233</item>
        <item name="colorOnPrimary">#E8EEF4</item>
        <item name="colorOnSecondary">#E8EEF4</item>
        <item name="colorSurface">#0F2233</item>
        <item name="colorOnSurface">#E8EEF4</item>
        <item name="colorBackground">#0B1929</item>
        <item name="android:colorBackground">#0B1929</item>
        <item name="android:colorForeground">#E8EEF4</item>

        <!-- إلغاء Material Button الافتراضي -->
        <item name="materialButtonStyle">@style/WolfButton</item>
        <item name="buttonStyle">@style/WolfButton</item>

        <!-- شريط الحالة والملاحة -->
        <item name="android:statusBarColor">#0B1929</item>
        <item name="android:navigationBarColor">#0F2233</item>
        <item name="android:windowBackground">#0B1929</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="WolfButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">#132A3E</item>
        <item name="android:textColor">#E8EEF4</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
